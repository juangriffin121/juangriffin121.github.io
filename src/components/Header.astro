---
import Navigation from './Navigation.astro'
import ThemeToggle from './ThemeToggle.astro'
import Social from './Social.astro'
---

<header>
  <div class="header-left">
    <Social />
  </div>

  <div class="header-inner">
    <nav aria-label="Primary navigation">
      <Navigation />
    </nav>
  </div>

  <ThemeToggle />
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    min-height: 58px;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;

    align-items: center;
    justify-content: space-between;
  }

  :global(body) {
    padding-top: 58px;
  }

  .header-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem;
    display: flex;
    justify-content: center;
  }
  
  .header-left {
    list-style: none;
    display: flex;
    padding: 0;
    margin: 0;
  }

</style>
