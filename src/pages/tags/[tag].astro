---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { slugifyTag } from "../../utils/tags"

const allProjects = Object.values(import.meta.glob('../projects/*.md', {eager: true}));

export async function getStaticPaths() {
  const uniqueTags = [...new Set(allProjects.map((p: any) => p.frontmatter.tags).flat())]; /* ... expands (like *array in python) new Set creates a set, Set(...) alone doesnt work*/ 

  return uniqueTags.map((tag) => {
    const filteredProjects = allProjects.filter((p: any) => p.frontmatter.tags?.includes(tag));

    return {    
      params: {tag: slugifyTag(tag)},
      props: {projects: filteredProjects},
    }
  }) 
};

const { tag: tagSlug } = Astro.params;
const { projects } = Astro.props;
const tag = allProjects
  .flatMap((project: any) => project.frontmatter.tags)
  .find((value: string) => slugifyTag(value) === tagSlug) ?? tagSlug;

// try to load a skill md if it exists
const skillModules = import.meta.glob('./content/*.md', { eager: true });
const skillDoc = skillModules[`./content/${tag}.md`];
---

<BaseLayout pageTitle={tag}>
  {skillDoc ? (
    <article class="prose">
      <skillDoc.Content />
    </article>
  ) : (
    <p class="muted">
      Projects where I used <strong>{tag}</strong>.
    </p>
  )}

  <div class="tagged-projects">
    {projects.map((project: any) => (
      <a href={project.url}>{project.frontmatter.title}</a>
    ))}
  </div>
</BaseLayout>

<style>
  .tagged-projects {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .tagged-projects a {
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background-color: transparent;
  }

  .tagged-projects a:hover {
    background-color: var(--hover-bg);
    border-color: var(--fg);
  }
</style>
