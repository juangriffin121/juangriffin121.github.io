---
import BaseLayout from "../../layouts/BaseLayout.astro"
import { slugifyTag } from "../../utils/tags"

export async function getStaticPaths() {
  const allProjects = Object.values(import.meta.glob('../projects/*.md', {eager: true}));
  const uniqueTags = [...new Set(allProjects.map((p: any) => p.frontmatter.tags).flat())]; /* ... expands (like *array in python) new Set creates a set, Set(...) alone doesnt work*/ 

  return uniqueTags.map((tag) => {
    const filteredProjects = allProjects.filter((p: any) => p.frontmatter.tags?.includes(tag));

    return {    
      params: {tag: slugifyTag(tag)},
      props: { projects: filteredProjects, tag },
    }
  }) 
};

const { projects, tag } = Astro.props;

// try to load a skill md if it exists
const skillModules = import.meta.glob('./content/*.md', { eager: true });
const skillDoc = skillModules[`./content/${tag}.md`];
const description = skillDoc?.frontmatter?.description ?? `Projects where I used ${tag}.`;
---

<BaseLayout pageTitle={tag} description={description}>
  {skillDoc ? (
    <>
      <p class="skill-description">{description}</p>
      <article class="prose">
        <skillDoc.Content />
      </article>
    </>
  ) : (
    <p class="muted">
      Projects where I used <strong>{tag}</strong>.
    </p>
  )}

  <h2>Projects using this skill</h2>
  <ul class="tagged-projects">
    {projects.map((project: any) => (
      <li><a href={project.url}>{project.frontmatter.title}</a></li>
    ))}
  </ul>
</BaseLayout>

<style>
  .tagged-projects {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  .skill-description {
    color: var(--muted);
    font-size: 1.1rem;
  }

  .tagged-projects a {
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background-color: transparent;
  }

  .tagged-projects a:hover {
    background-color: var(--hover-bg);
    border-color: var(--fg);
  }
</style>
