---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { slugifyTag } from '../../utils/tags'

const pageTitle = "Projects"
const allProjects = Object.values(import.meta.glob('./*.md', {eager: true}));
---

<BaseLayout pageTitle={pageTitle}>
  <p class="intro">Selected projects in machine learning, simulation, systems programming, and data analysis. Each one is an attempt to understand a system by building a working version of it.</p>
  <div class="projects">
    {allProjects.map((project: any) => (
      <article class="project-card">
        <a class="card-link" href={project.url}>
        <h2>
          {project.frontmatter.title}
        </h2>

        <p class="project-description">
          {project.frontmatter.description}
        </p>
        </a>

        <ul class="project-tags">
          {project.frontmatter.tags.map((tag: string) => (
            <li><a href={`/tags/${slugifyTag(tag)}`}>{tag}</a></li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</BaseLayout>

<style>
  /* -----------------------
     Projects list
  ------------------------ */
  .projects {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* -----------------------
     Project card
  ------------------------ */
  .project-card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
    transition:
      background-color var(--transition),
      border-color var(--transition);
  }

  .intro { color: var(--muted); }

  .project-card:hover {
    background-color: var(--hover-bg);
    border-color: var(--fg);
  }

  /* -----------------------
     Project title
  ------------------------ */
  .project-card h2 {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
  }

  .card-link { display: block; }

  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-tags { position: relative; }

  /* -----------------------
     Description
  ------------------------ */
  .project-description {
    margin: 0 0 0.75rem 0;
    color: var(--muted);
  }

  /* -----------------------
     Tags
  ------------------------ */
  .project-tags {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .project-tags a {
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background-color: transparent;
  }

  .project-tags a:hover {
    background-color: var(--bg);
    border-color: var(--fg);
  }
</style>
