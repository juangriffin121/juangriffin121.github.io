<style>

  .tool a {
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .tool a:hover {
    color: var(--accent);
    background-color: var(--bg);
  }

  .external-link-icon {
    font-size: 1rem;
    opacity: 0.6;
  }
</style>
