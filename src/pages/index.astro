---
import BaseLayout from '../layouts/BaseLayout.astro'
import { slugifyTag } from '../utils/tags'

const pageTitle = "Juan Griffin"

const featuredUrls = [
  '/projects/president-rl',
  '/projects/digit-recognizer',
  '/projects/evolution-simulator',
]
const allProjects = Object.values(import.meta.glob('./projects/*.md', { eager: true })) as any[]
const featured = featuredUrls
  .map((url) => allProjects.find((p) => p.url === url))
  .filter(Boolean)

const skills = [...new Set(allProjects.flatMap((p) => p.frontmatter.tags))] as string[]
---

<BaseLayout
  pageTitle={pageTitle}
  documentTitle="Juan Griffin | Machine learning & systems programming"
  hideTitle
>
  <section class="hero" aria-labelledby="hero-name">
    <p class="eyebrow">Portfolio</p>
    <h1 id="hero-name">Juan Griffin</h1>
    <p class="lead">
      Biotechnology graduate and self-taught machine learning and systems programmer.
    </p>
    <p class="tagline">
      I build things from first principles: neural networks, simulations, control systems, and developer tools.
    </p>

    <div class="actions">
      <a class="button primary" href="/projects">Explore my projects <span aria-hidden="true">→</span></a>
      <a class="button" href="/about">About me</a>
      <a class="button" href="mailto:griffinjuan42@gmail.com">Email me</a>
      <a class="button" href="https://github.com/juangriffin121" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
    </div>

    <ul class="skills" aria-label="Skills">
      {skills.map((skill) => (
        <li><a href={`/tags/${slugifyTag(skill)}`}>{skill}</a></li>
      ))}
    </ul>
  </section>

  <section class="featured" aria-labelledby="featured-heading">
    <div class="featured-head">
      <h2 id="featured-heading">Selected work</h2>
      <a class="all-link" href="/projects">All projects →</a>
    </div>

    <div class="cards">
      {featured.map((project) => (
        <article class="card">
          {project.frontmatter.thumbnail && (
            <img
              class="thumb"
              src={project.frontmatter.thumbnail}
              alt=""
              width="1200"
              height="675"
              loading="lazy"
              decoding="async"
            />
          )}
          <a class="card-link" href={project.url}>
            <h3>{project.frontmatter.title}</h3>
            <p>{project.frontmatter.description}</p>
          </a>
          <ul class="card-tags">
            {project.frontmatter.tags.map((tag: string) => (
              <li><a href={`/tags/${slugifyTag(tag)}`}>{tag}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 3rem 0 2.5rem;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .hero h1 {
    margin: 0 0 1rem;
    font-size: clamp(2.75rem, 8vw, 4.5rem);
    letter-spacing: -0.02em;
    border-bottom: none;
  }

  .lead {
    margin: 0 0 0.75rem;
    max-width: 34ch;
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    line-height: 1.4;
  }

  .tagline {
    margin: 0 0 2rem;
    max-width: 56ch;
    font-size: 1.1rem;
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .button {
    display: inline-block;
    padding: 0.6rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .button:hover,
  .button:focus-visible {
    border-color: var(--fg);
  }

  .button.primary {
    background-color: var(--fg);
    color: var(--bg);
    border-color: var(--fg);
    font-weight: 600;
  }

  .button.primary:hover,
  .button.primary:focus-visible {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #0f0f0f;
  }

  .skills,
  .card-tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .skills a,
  .card-tags a {
    display: inline-block;
    font-size: 0.85rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .skills a:hover,
  .card-tags a:hover {
    border-color: var(--fg);
  }

  .featured {
    padding-top: 1rem;
  }

  .featured-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .featured-head h2 {
    margin: 1.5rem 0 1rem;
    font-size: 1.5rem;
  }

  .all-link {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .all-link:hover {
    color: var(--fg);
    background: transparent;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition:
      background-color var(--transition),
      border-color var(--transition);
  }

  .card:hover {
    background-color: var(--hover-bg);
    border-color: var(--fg);
  }

  .thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
  }

  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .card-link {
    flex: 1;
  }

  .card-link:hover {
    background: transparent;
  }

  /* Whole card is clickable; tags sit above the overlay. */
  .card-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-tags {
    position: relative;
  }

  @media (max-width: 600px) {
    .hero {
      padding-top: 1.5rem;
    }
  }
</style>
